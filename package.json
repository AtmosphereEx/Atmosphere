{
    "name": "atmosphere-client",
    "version": "1.0.0",
    "description": "AtmosphereEx - Next-Gen Proxy & Tunnel Suite",
    "main": "dist-electron/main/index.js",
    "scripts": {
        "dev": "concurrently -k \"vite\" \"cross-env NODE_ENV=development electron .\"",
        "build:renderer": "vite build",
        "build:main": "tsc -p tsconfig.node.json",
        "build": "npm run build:renderer && npm run build:main",
        "start": "electron .",
        "download-cores": "node scripts/download-cores.js"
    },
    "keywords": [
        "vpn",
        "proxy",
        "sing-box",
        "xray",
        "vless",
        "vmess",
        "tun",
        "happ"
    ],
    "author": "",
    "license": "MIT",
    "dependencies": {
        "country-flag-icons": "^1.6.20",
        "lucide-react": "^1.16.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.13.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.4",
        "autoprefixer": "^10.4.20",
        "concurrently": "^9.1.2",
        "cross-env": "^7.0.3",
        "electron": "^34.2.0",
        "postcss": "^8.5.1",
        "tailwindcss": "^3.4.17",
        "typescript": "^5.7.3",
        "vite": "^6.1.0"
    }
}
